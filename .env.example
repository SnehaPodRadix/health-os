# Secret used to sign session JWTs. REQUIRED in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Seed credentials for the in-memory demo user (dev only).
# Remove these once a real user store is wired in.
DEMO_USERNAME=demo
DEMO_PASSWORD=password123

# Saif — Gemini API key for the /saif-chat health chat feature.
# Get one free at https://aistudio.google.com/apikey
# If empty or over quota, /saif-chat falls back to a pre-defined demo chat.
NUXT_PUBLIC_SAIF_GEMINI_API_KEY=
